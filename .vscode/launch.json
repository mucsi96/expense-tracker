{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "name": "Start server",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "cargo": {
        "args": ["build", "--manifest-path", "${workspaceFolder}/server/Cargo.toml"],
        "filter": { "name": "expense-tracker-server", "kind": "bin" }
      },
      "args": ["start", "--no-banner"],
      "envFile": "${workspaceFolder}/server/.env"
    }
  ]
}
